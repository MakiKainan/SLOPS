# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PUBLIC_URL: Public base URL of the phone upload page (port 3001), e.g. https://upload.example.com
# when you run your own named Cloudflare Tunnel. Leave empty to start a free quick tunnel
# automatically (needs `cloudflared` installed: winget install --id Cloudflare.cloudflared).
PUBLIC_URL=""
